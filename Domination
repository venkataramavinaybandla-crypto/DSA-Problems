import java.util.*;

class Codechef {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();

            ArrayList<Integer>[] graph = new ArrayList[N + 1];

            for (int i = 1; i <= N; i++) {
                graph[i] = new ArrayList<>();
            }

            for (int i = 0; i < N - 1; i++) {
                int u = sc.nextInt();
                int v = sc.nextInt();

                graph[u].add(v);
                graph[v].add(u);
            }

            long total = (long) N * (N - 1) * (N - 2) / 6;

            long leaves = 0;
            long overlap = 0;

            // Count leaves and overlaps between leaf-edges
            for (int v = 1; v <= N; v++) {
                int leafCount = 0;

                for (int u : graph[v]) {
                    if (graph[u].size() == 1) {
                        leafCount++;
                    }
                }

                if (graph[v].size() == 1) {
                    leaves++;
                }

                overlap += (long) leafCount * (leafCount - 1) / 2;
            }

            long badLeaf = leaves * (N - 2L) - overlap;

            long degree2Extra = 0;

            for (int v = 1; v <= N; v++) {
                if (graph[v].size() == 2) {
                    int a = graph[v].get(0);
                    int b = graph[v].get(1);

                    // Not already counted by a leaf-edge
                    if (graph[a].size() > 1 &&
                        graph[b].size() > 1) {
                        degree2Extra++;
                    }
                }
            }

            long answer = total - badLeaf - degree2Extra;

            System.out.println(answer);
        }
    }
}
