import java.util.*;
import java.io.*;

class Codechef {
    static int n;
    static boolean[][] g;
    static int[] match, p, base, q;
    static boolean[] used, blossom;

    static int lca(int a, int b) {
        boolean[] u = new boolean[n];
        while (true) {
            a = base[a];
            u[a] = true;
            if (match[a] == -1) break;
            a = p[match[a]];
        }
        while (true) {
            b = base[b];
            if (u[b]) return b;
            b = p[match[b]];
        }
    }

    static void markPath(int v, int b, int children) {
        while (base[v] != b) {
            blossom[base[v]] = blossom[base[match[v]]] = true;
            p[v] = children;
            children = match[v];
            v = p[match[v]];
        }
    }

    static int findPath(int root) {
        Arrays.fill(used, false);
        Arrays.fill(p, -1);
        for (int i = 0; i < n; i++) base[i] = i;
        used[root] = true;
        int qh = 0, qt = 0;
        q[qt++] = root;
        while (qh < qt) {
            int v = q[qh++];
            for (int to = 0; to < n; to++) {
                if (!g[v][to]) continue;
                if (base[v] == base[to] || match[v] == to) continue;
                if (to == root || (match[to] != -1 && p[match[to]] != -1)) {
                    int cb = lca(v, to);
                    Arrays.fill(blossom, false);
                    markPath(v, cb, to);
                    markPath(to, cb, v);
                    for (int i = 0; i < n; i++) {
                        if (blossom[base[i]]) {
                            base[i] = cb;
                            if (!used[i]) {
                                used[i] = true;
                                q[qt++] = i;
                            }
                        }
                    }
                } else if (p[to] == -1) {
                    p[to] = v;
                    if (match[to] == -1) return to;
                    int t2 = match[to];
                    used[t2] = true;
                    q[qt++] = t2;
                }
            }
        }
        return -1;
    }

    static boolean good(int a, int b, int K) {
        int prod = a * b;
        for (int x = 1; x <= 60; x++) {
            if (Math.abs(prod - x * x) <= K) return true;
        }
        return false;
    }

    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int T = Integer.parseInt(br.readLine().trim());
        StringBuilder sb = new StringBuilder();
        while (T-- > 0) {
            StringTokenizer st = new StringTokenizer(br.readLine());
            int N = Integer.parseInt(st.nextToken());
            int K = Integer.parseInt(st.nextToken());

            n = (N % 2 == 1) ? N + 1 : N;   // dummy vertex index N when N is odd
            g = new boolean[n][n];
            for (int a = 1; a <= N; a++)
                for (int b = a + 1; b <= N; b++)
                    if (good(a, b, K)) g[a - 1][b - 1] = g[b - 1][a - 1] = true;
            if (N % 2 == 1)
                for (int a = 0; a < N; a++) g[a][N] = g[N][a] = true;

            match = new int[n];
            p = new int[n];
            base = new int[n];
            q = new int[n + 5];
            used = new boolean[n];
            blossom = new boolean[n];
            Arrays.fill(match, -1);

            for (int i = 0; i < n; i++) {
                if (match[i] == -1) {
                    int v = findPath(i);
                    while (v != -1) {
                        int pv = p[v], ppv = match[pv];
                        match[v] = pv;
                        match[pv] = v;
                        v = ppv;
                    }
                }
            }

            boolean ok = true;
            for (int i = 0; i < n; i++) if (match[i] == -1) ok = false;
            if (!ok) {
                sb.append("-1\n");
                continue;
            }

            int single = -1;
            boolean[] done = new boolean[n];
            StringBuilder line = new StringBuilder();
            for (int i = 0; i < N; i++) {
                if (done[i]) continue;
                int m = match[i];
                if (m == N && N % 2 == 1) { single = i; done[i] = true; continue; }
                done[i] = done[m] = true;
                line.append(i + 1).append(' ').append(m + 1).append(' ');
            }
            if (single != -1) line.append(single + 1);
            sb.append(line.toString().trim()).append('\n');
        }
        System.out.print(sb);
    }
}
