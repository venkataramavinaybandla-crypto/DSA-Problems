import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		 Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();
            int M = sc.nextInt();

            String S = sc.next();
            String L = sc.next();

            int current = 0;
            int max = 0;
            char previous = ' ';

            for (char c : S.toCharArray()) {

                char hand = L.indexOf(c) != -1 ? 'L' : 'R';

                if (hand == previous) {
                    current++;
                } else {
                    current = 1;
                    previous = hand;
                }

                max = Math.max(max, current);
            }

            System.out.println(max);
        }

	}
}
